# Supabase project settings -> API. Both are safe to expose to the browser;
# row-level security keeps each instructor's data private.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Leave both unset to run the app in "this device only" mode (localStorage,
# no sign-in) - handy for trying it out before Supabase is set up.
